# Substack authentication
# To get your substack.sid cookie:
# 1. Login to Substack in your browser
# 2. Open Developer Tools (F12)
# 3. Go to Application tab → Cookies → https://substack.com
# 4. Find the "substack.sid" cookie and copy its value
SUBSTACK_TOKEN=your-substack-sid-cookie-value

# Your Substack publication URL (e.g. yourname.substack.com)
SUBSTACK_PUBLICATION_URL=yourname.substack.com
